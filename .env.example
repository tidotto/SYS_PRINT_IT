# =======================================================
# SysPrint TI — Exemplo de Variáveis de Ambiente (.env)
# =======================================================

# Porta e interface de rede para o painel web
PORT=3000
HOST=0.0.0.0

# Servidor Windows de Impressão (Fila Spooler via PowerShell)
PRINT_SERVER_HOST=192.168.1.211
PRINT_SERVER_NAME=SRV-TS

# Compartilhamento de Rede & Autenticação SMB do PaperCut
PAPERCUT_SHARE_UNC=\\SRV-TS\PaperCut Print Logger
PAPERCUT_SHARE_USER=dominio\usuario_suporte
PAPERCUT_SHARE_PASSWORD=coloque_sua_senha_aqui
PAPERCUT_LOGS_DIR=\\SRV-TS\PaperCut Print Logger\logs\csv\daily

# Periodicidade de sincronização do PaperCut (em minutos) e profundidade (dias)
PAPERCUT_SYNC_INTERVAL_MIN=5
PAPERCUT_SYNC_DAYS_BACK=2
PAPERCUT_INITIAL_DAYS_BACK=45

# Configurações do protocolo SNMP (UDP 161)
SNMP_COMMUNITY=public
SNMP_TIMEOUT_MS=2500
SNMP_CONCURRENCY=10
SCAN_INTERVAL_MIN=5

# Configurações de E-mail (Zimbra SMTP)
EMAIL_SMTP_SERVER=zimbramail.penso.com.br
EMAIL_SMTP_PORT=465
EMAIL_USER=recibo@drcentral.com.br
EMAIL_PASSWORD=sua_senha_aqui
EMAIL_NOTIFY_TO=ti@centraldeconsultas.med.br
EMAIL_DAILY_REPORT_TIME=08:00
EMAIL_NOTIFICATIONS_ENABLED=true
